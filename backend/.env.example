# Backend environment. Copy to backend/.env and fill in real values.
# Every variable here is validated on boot by src/lib/config.ts (S7-04);
# a bad or missing one stops the server and names the variable.

# Required — the Postgres connection string. Local Postgres is on port 5434.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5434/fitfirst"

# Required — the four-digit staff passcode for the dashboard. Never commit a real one.
DASHBOARD_PIN="0000"

# Optional — defaults shown. Omit a line to take its default.
PORT="3008"
NODE_ENV="development"
KIOSK_URL="http://localhost:5174"
DASHBOARD_URL="http://localhost:5173"
AI_SERVICE_URL="http://localhost:8000"
