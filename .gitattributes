# Normalise text files to LF in the repository; each checkout uses its own line endings.
* text=auto

# Windows scripts keep CRLF; shell scripts keep LF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh  text eol=lf

# Binary files: never touch line endings or diff as text.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
