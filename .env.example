# Database (Postgres via Docker or local install)
DATABASE_URL="postgresql://fitfirst:fitfirst_dev@localhost:5432/fitfirst?schema=public"

# API server port
PORT=3000

# Kiosk app URL (used for CORS)
KIOSK_URL="http://localhost:5174"

# Dashboard app URL (used for CORS)
DASHBOARD_URL="http://localhost:5173"

# Staff dashboard PIN (simple auth for Phase 1).
# Enforced both client-side (dashboard UI gate) and server-side (backend
# requires this value in the x-dashboard-pin header on all staff-only
# endpoints — see backend/src/authGuard.ts). Also set as VITE_DASHBOARD_PIN
# in the dashboard app so the two stay in sync.
DASHBOARD_PIN="1234"

# Environment
NODE_ENV="development"
