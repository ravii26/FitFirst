# Database (Postgres via Docker or local install)
DATABASE_URL="postgresql://fitfirst:fitfirst_dev@localhost:5432/fitfirst?schema=public"

# API server port
PORT=3000

# Kiosk app URL (used for CORS)
KIOSK_URL="http://localhost:5174"

# Dashboard app URL (used for CORS)
DASHBOARD_URL="http://localhost:5173"

# Staff PIN is checked only by the backend. Choose your own four-digit PIN.
# Never put this value in a VITE_ environment variable.
DASHBOARD_PIN="1234"

# Environment
NODE_ENV="development"
