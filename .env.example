# Database (Postgres via Docker or local install)
# docker-compose.yml publishes Postgres on host port 5434. For a local install on the
# standard port, change 5434 to 5432.
DATABASE_URL="postgresql://fitfirst:fitfirst_dev@localhost:5434/fitfirst?schema=public"

# API server port
PORT=3000

# Kiosk app URL (used for CORS)
KIOSK_URL="http://localhost:5174"

# Dashboard app URL (used for CORS)
DASHBOARD_URL="http://localhost:5173"

# Staff PIN is checked only by the backend. Choose your own four-digit PIN.
# Never put this value in a VITE_ environment variable.
DASHBOARD_PIN="1234"

# Environment
NODE_ENV="development"

# Where the backend finds the garment tagger (backend/ai-service). Default: http://localhost:8000
# AI_SERVICE_URL="http://localhost:8000"

# Garment tagger (backend/ai-service) — AI calls go through AICredits.
# Put your own key in backend/.env; never commit it.
AICREDITS_API_KEY=
# Optional: override the tagging model (default is in backend/ai-service/classifier.py)
# AICREDITS_TAG_MODEL=google/gemini-2.5-flash-lite
# Optional: set to 0 if the gateway or model rejects the JSON response schema
# AICREDITS_JSON_SCHEMA=1
