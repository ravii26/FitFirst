{
  "name": "fitfirst",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend",
    "dashboard",
    "kiosk"
  ],
  "scripts": {
    "brief": "node scripts/session-brief.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=dashboard\" \"npm run dev --workspace=kiosk\"",
    "build": "npm run build --workspace=backend && npm run build --workspace=dashboard && npm run build --workspace=kiosk",
    "test": "npm run test --workspace=backend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "db:reset": "npm run db:reset --workspace=backend",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^8.2.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.0"
  }
}
